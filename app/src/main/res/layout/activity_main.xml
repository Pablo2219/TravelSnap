<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/places" android:textSize="26sp"/>
        <Button android:id="@+id/btnNewPlace" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/manage_places" android:enabled="true"/>
        <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search_future" android:inputType="text" android:enabled="false"/>
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/empty_places" android:textSize="18sp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPlaces" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/btnMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_title" android:enabled="true"/>
        <Button android:id="@+id/btnPhotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/photos_title" android:enabled="true"/>
        <Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_title" android:enabled="true"/>
    </LinearLayout>
</LinearLayout>
